# Copy to .env.local, the file the Ponder CLI loads. Never commit it.

# Paid RPC for Robinhood Chain (4663). Required, with no fallback: Alchemy's free tier caps
# eth_getLogs at 10 blocks and the public RPC answers 429, so neither can backfill.
PONDER_RPC_URL=

# Postgres connection string, in the form postgres://ROLE:PASSWORD@HOST:PORT/farmenta.
# Local: role `farmenta_indexer`, the POSTGRES_PASSWORD below, 127.0.0.1:5434.
# VPS: the `farmenta_indexer` role on the shared server (README, "Deploy").
# It carries a password: it belongs in .env.local only, never in the README, an issue,
# a commit message or a pm2 process file.
DATABASE_URL=

# Local only. Password the Docker Postgres is created with (`pnpm db:up`). Pick any value,
# e.g. `openssl rand -hex 16`, and use the same one inside DATABASE_URL.
POSTGRES_PASSWORD=

# Name of a file in deployments/ (without .json) holding the Farmenta addresses.
# Empty: only the Uniswap contracts are indexed.
FARMENTA_DEPLOYMENT=

# Optional, local development only. Lifts every startBlock to at least this block so
# `pnpm dev` does not backfill the whole chain. Leave empty in production.
START_BLOCK_FLOOR=

# Optional. Milliseconds between polls for new blocks (default 2000).
POLLING_MS=

# Optional. Port of the HTTP server that serves /status (default 42069).
PORT=
