# Copy to .env. Never commit .env.

# RPC for Robinhood Chain (4663). Production follows the chain on dRPC since 2 Oct 2026;
# on the public RPC it fell behind. A full backfill from block 9,070 was estimated to take
# 60 days on the public RPC; production uses a start block.
PONDER_RPC_URL=

# Postgres connection string, in the form postgres://ROLE:PASSWORD@HOST:PORT/farmenta.
# Local: role `farmenta_indexer`, the POSTGRES_PASSWORD below, 127.0.0.1:5434.
# VPS: the `farmenta_indexer` role on the shared server (README, "Deploy").
# It carries a password: it belongs in .env only, never in the README, an issue,
# a commit message or a pm2 process file.
DATABASE_URL=

# Local only. Password the Docker Postgres is created with (`pnpm db:up`). Pick any value,
# e.g. `openssl rand -hex 16`, and use the same one inside DATABASE_URL.
POSTGRES_PASSWORD=

# Name of a file in deployments/ (without .json) holding the Farmenta addresses.
# Empty: only the Uniswap contracts are indexed.
FARMENTA_DEPLOYMENT=

# Optional start block floor. Production currently uses 77197166, the first block of the
# Farmenta deployment of 1 Oct 2026 (the deployment it replaced started at 74901824).
START_BLOCK_FLOOR=

# Optional. Milliseconds between polls for new blocks (default 2000).
POLLING_MS=

# Optional. Largest block range of one eth_getLogs request. Empty: Ponder infers it from the
# RPC's errors. dRPC needs it: its free plan rejects ranges above about 100 blocks with a
# message Ponder 0.17.10 does not recognise, so the sync fails instead of shrinking the range.
# Production uses 100.
ETH_GET_LOGS_BLOCK_RANGE=

# Optional. Port of the HTTP server that serves /status (default 42069). On the VPS, 42070
# is already taken by the lp-monitor-v2 indexer.
PORT=
